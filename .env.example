# Copy to .env (next to where you run padscreen) or to ~/.config/padscreen/padscreen.env, then edit.
# Real environment variables override both files. Every value below is optional; the defaults are shown.
# Command-line flags override everything. The real .env is git-ignored.

# --- network ---
# Address to listen on. Peers other than loopback and the USB link are refused anyway (see PADSCREEN_ALLOW_LAN).
#PADSCREEN_BIND=0.0.0.0
#PADSCREEN_PORT=8443

# --- TLS (make these with scripts/gen-cert.sh) ---
# Defaults: leaf.crt, leaf.key and ca.crt inside ~/.config/padscreen
#PADSCREEN_CERT=/path/to/leaf.crt
#PADSCREEN_KEY=/path/to/leaf.key
#PADSCREEN_CA_CERT=/path/to/ca.crt

# --- access control ---
# Serve every peer that can reach the port, not just the USB link. Anyone then sees and controls this PC.
#PADSCREEN_ALLOW_LAN=false
# View only: ignore touch and mouse from the iPad.
#PADSCREEN_NO_INPUT=false

# --- defaults for the iPad (the iPad's own settings menu overrides these) ---
# Where the iPad sits relative to the laptop screen: right | left | above | below
#PADSCREEN_LAYOUT=right
# UI scale of the iPad screen, 1 to 3 (2 suits a 264 ppi iPad)
#PADSCREEN_UI_SCALE=2
# Fraction of the iPad's pixels that is streamed, 0.25 to 1
#PADSCREEN_RES=1
# latency | balanced | quality | saver
#PADSCREEN_PROFILE=balanced

# --- encoder ---
# auto | nvenc | vaapi | x264
#PADSCREEN_ENCODER=auto
# Seconds to keep the virtual monitor after the iPad disconnects
#PADSCREEN_IDLE_TIMEOUT=60
# Override the profile: frames per second, kbit/s, keyframe interval in frames
#PADSCREEN_FPS=
#PADSCREEN_BITRATE_KBPS=
#PADSCREEN_GOP=

# --- backend (default follows $XDG_SESSION_TYPE) ---
# wayland: GNOME virtual monitor.  x11: a spare RandR output.
#PADSCREEN_BACKEND=
#PADSCREEN_OUTPUT=
#PADSCREEN_REFERENCE=
#PADSCREEN_HZ=60
#PADSCREEN_OFFSET=0
#PADSCREEN_SIZE=

# --- logging ---
#RUST_LOG=info
